# Điền khoá API rồi đổi tên file thành .env
# Anthropic (trợ lý AI, đọc ảnh / PDF scan) – lấy tại https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Tuỳ chọn: Gemini, chỉ để gỡ băng file ghi âm và tìm theo ý nghĩa (Anthropic chưa có hai tính năng này) – https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Trợ lý chỉ dùng Anthropic; dữ liệu công ty không tự chuyển sang nhà cung cấp khác khi hết hạn mức.
# Tuỳ chọn: AZB_CHAT_MODEL=claude-haiku-5-5 (chat mặc định, rẻ), AZB_SMART_MODEL=claude-sonnet-5-5 (đề nghị nâng lên khi câu hỏi khó),
#           AZB_ANTHROPIC_MODEL=claude-sonnet-5-5 (đọc scan/OCR; đổi sang claude-opus-5-5 nếu cần, đắt hơn nhiều),
#           AZB_ANTHROPIC_FALLBACKS=claude-sonnet-5-5,claude-haiku-5-5 (model dự phòng khi hết hạn mức; chỉ dùng model KHÔNG đắt hơn model đã chọn),
#           AZB_ANTHROPIC_EFFORT=low (mặc định; high = suy nghĩ sâu, tốn hơn)
# Số vòng tra cứu: AZB_MAX_TOOL_ROUNDS=4, AZB_LIGHT_TOOL_ROUNDS=3 (Haiku), AZB_EXTRA_REASON_ROUNDS=3 (cộng thêm cho câu cần suy luận/đối chiếu)
# Chi phí (USD): AZB_DAILY_BUDGET_USD=10 (cả công ty/ngày), AZB_USER_DAILY_BUDGET_USD=2 (mỗi người), AZB_EXEC_DAILY_BUDGET_USD=6 (mỗi admin/TGĐ),
#           AZB_QUESTION_BUDGET_USD=1 (trần cho MỘT câu hỏi: chạm trần thì dừng tra cứu và trả lời bằng dữ liệu đã có),
#           AZB_RESERVE_USD=0.3 (giữ chỗ cho mỗi câu đang chạy để nhiều câu cùng lúc không vượt ngân sách); 0 = tắt từng trần
# Kích thước: AZB_TOOL_RESULT_CHARS=24000 (kết quả một công cụ dài hơn thì bị cắt, vì được gửi lại ở mọi vòng)

# --- Bảo mật & sao lưu (tuỳ chọn) ---
# Thư mục sao lưu: nên đặt sang ổ khác/NAS (mặc định data/backups cùng ổ với dữ liệu, không cứu được khi hỏng ổ)
# AZB_BACKUP_DIR=D:\AZB_Backup
# AZB_BACKUP_KEEP=14        # số bản database giữ lại
# AZB_BACKUP_HOURS=24       # chu kỳ sao lưu tự động (0 = tắt)
# AZB_MAX_HISTORY_MESSAGES=8   # số tin gần nhất gửi lại cho AI mỗi câu hỏi (ít hơn = rẻ hơn)
# AZB_OLD_ANSWER_CHARS=1200    # câu trả lời cũ của AI (trừ 2 lượt gần nhất) chỉ giữ chừng này ký tự khi gửi lại
# AZB_AI_PER_MINUTE=8       # giới hạn câu hỏi AI mỗi tài khoản
# AZB_AI_PER_DAY=300
# AZB_COOKIE_SECURE=1       # ép cookie đăng nhập chỉ đi qua HTTPS (tự bật khi truy cập bằng https)
# AZB_EMBED_SYNC=1          # tuỳ chọn: tạo vector tìm theo ý nghĩa cho tài liệu (GỬI nội dung tài liệu tới Gemini). Mặc định tắt
# AZB_EMBED_MIN=0.6         # ngưỡng điểm tương đồng của tìm theo ý nghĩa (chưa hiệu chỉnh trên dữ liệu thật)
# So sánh đọc scan Claude/Gemini (python -m backend.ocr_compare): AZB_GEMINI_OCR_MODEL (mặc định như AZB_GEMINI_MODEL),
#   AZB_PRICE_GEMINI=in,out (USD/1 triệu token, mặc định 0.5,3 chưa đối chiếu giá chính thức), AZB_EST_CLAUDE_IN_PER_PAGE=2500, AZB_EST_GEMINI_IN_PER_PAGE=1000, AZB_EST_OUT_PER_PAGE=900 (ước tính chạy thử)
# Số dư tín dụng trên trang Chi phí AI: AZB_CREDIT_USD=20 (số tiền đã nạp vào Anthropic, USD; 0 = không hiện), AZB_CREDIT_SINCE=2026-10-22 (chỉ tính chi phí từ ngày nạp; bỏ trống = toàn bộ nhật ký)
